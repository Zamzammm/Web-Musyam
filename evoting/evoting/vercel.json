{
    "version": 2,
    "builds": [
        {
            "src": "backend/api/*.php",
            "use": "vercel-php@0.6.1"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.css",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.js",
            "use": "@vercel/static"
        }
    ]
}